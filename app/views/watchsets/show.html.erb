<% content_for :navtitle do %>
  <%= @watchset.name %>
<% end %>
<% if @watchbill.watchbill_station_assignments.empty? && @watchset.watchstations.any? %>
  <div class="alert alert-warning" role="alert">
    No valid watchbill exists: there are not enough qualified workers to fill every watchstation on every shift.
  </div>
<% end %>
<%= link_to "Add or remove watchstations", edit_watchset_path(@watchset), class: "btn btn-outline-primary my-2" %>
<p>
  <%= link_to "Saved watchbills (#{@watchset.watchbills.count})", watchset_watchbills_path(@watchset) %>
</p>
<% if @watchbill.watchbill_station_assignments.any? %>
  <%= form_with model: @watchbill, url: watchset_watchbills_path(@watchset), class: "save-watchbill" do |form| %>
    <%= form.fields_for :watchbill_station_assignments do |fields| %>
      <%= fields.hidden_field :watchstation_id %>
      <%= fields.hidden_field :shift %>
      <%= fields.hidden_field :worker_id %>
    <% end %>
    <%= form.submit "Save this watchbill", class: "btn btn-primary" %>
  <% end %>
<% end %>
<%= paginate(@grid.assets) %>
<%= datagrid_table @grid %>
<%= paginate(@grid.assets) %>
