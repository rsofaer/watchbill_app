<% content_for :navtitle do %>
  Editing <%= @watchset.name_was %>
<% end %>

<h2 class="h4 mt-3">Name</h2>
<%= render "watchsets/errors", record: @watchset %>
<%= form_with model: @watchset, class: "row g-2 align-items-end" do |f| %>
  <div class="col-auto">
    <%= f.label :name, class: "visually-hidden" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= f.submit "Rename", class: "btn btn-outline-primary" %>
  </div>
<% end %>

<h2 class="h4 mt-4">Watchstations</h2>
<% stations = @watchset.watchstations.select(&:persisted?) %>
<% if stations.empty? %>
  <p class="text-muted">This watchset has no watchstations yet.</p>
<% else %>
  <table class="table table-sm align-middle" style="max-width: 40rem;">
    <thead>
      <tr><th>Watchstation</th><th>Qualification</th><th></th></tr>
    </thead>
    <tbody>
      <% stations.each do |station| %>
        <tr id="<%= dom_id(station) %>">
          <td><%= station.name %></td>
          <td><%= station.qualification.name %></td>
          <td class="text-end">
            <%= button_to "Remove", watchset_watchstation_path(@watchset, station),
                  method: :delete, class: "btn btn-sm btn-outline-danger",
                  form: { data: { turbo_confirm: "Remove #{station.name}?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<h2 class="h5 mt-3">Add a watchstation</h2>
<%= render "watchsets/errors", record: @watchstation %>
<%= form_with model: [@watchset, @watchstation], class: "row g-2 align-items-end" do |f| %>
  <div class="col-auto">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control" %>
  </div>
  <div class="col-auto">
    <%= f.label :qualification_id, "Qualification", class: "form-label" %>
    <%= f.collection_select :qualification_id, Qualification.order(:name), :id, :name,
          { prompt: "Select a qualification" }, class: "form-select" %>
  </div>
  <div class="col-auto">
    <%= f.submit "Add Watchstation", class: "btn btn-primary" %>
  </div>
<% end %>

<p class="mt-4"><%= link_to "View watchbill", watchset_path(@watchset) %></p>
