<% content_for :navtitle do %>
  <%= @worker.name %>
<% end %>
<h2>Qualifications</h2>
<% worker_qualifications = @worker.worker_qualifications.includes(:qualification).sort_by { |wq| wq.qualification.name } %>
<% if worker_qualifications.empty? %>
  <p>No qualifications.</p>
<% else %>
  <table class="table">
    <tbody>
      <% worker_qualifications.each do |wq| %>
        <tr>
          <td><%= wq.qualification.name %></td>
          <td class="text-end">
            <%= button_to "Remove", worker_worker_qualification_path(@worker, wq), method: :delete, class: "btn btn-sm btn-outline-danger" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% if @available_qualifications.any? %>
  <%= form_with model: WorkerQualification.new, url: worker_worker_qualifications_path(@worker), class: "row g-2" do |f| %>
    <div class="col-auto">
      <%= f.collection_select :qualification_id, @available_qualifications, :id, :name, {}, class: "form-select" %>
    </div>
    <div class="col-auto">
      <%= f.submit "Add Qualification", class: "btn btn-primary" %>
    </div>
  <% end %>
<% end %>

<p class="mt-3"><%= link_to "Back to Workers", workers_path %></p>
