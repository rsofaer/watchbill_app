<% content_for :navtitle do %>
  <%= @worker.name %>
<% end %>
<h2>Qualifications</h2>
<% if @worker.worker_qualifications.empty? %>
  <p class="no-qualifications">No qualifications.</p>
<% else %>
  <ul class="list-group mb-3 qualifications">
    <% @worker.worker_qualifications.includes(:qualification).each do |worker_qualification| %>
      <li class="list-group-item d-flex justify-content-between align-items-center">
        <%= worker_qualification.qualification.name %>
        <%= button_to "Remove", worker_worker_qualification_path(@worker, worker_qualification),
              method: :delete, class: "btn btn-sm btn-outline-danger" %>
      </li>
    <% end %>
  </ul>
<% end %>
<% if @available_qualifications.any? %>
  <%= form_with model: [ @worker, WorkerQualification.new ], class: "d-flex gap-2" do |form| %>
    <%= form.collection_select :qualification_id, @available_qualifications, :id, :name, {}, class: "form-select w-auto" %>
    <%= form.submit "Add qualification", class: "btn btn-primary" %>
  <% end %>
<% end %>
<p class="mt-3"><%= link_to "All workers", workers_path %></p>
